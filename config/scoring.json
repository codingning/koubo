{
  "version": "2.0-growth",
  "positiveWeights": {
    "authenticityAndEvidence": 18,
    "growthContinuity": 12,
    "audiencePracticalValue": 14,
    "changeConflictOrResult": 13,
    "visualEvidence": 10,
    "plainLanguage": 9,
    "resonanceOrDiscussion": 8,
    "nextDayHook": 7,
    "productionFeasibility": 9
  },
  "riskPenalty": {
    "formula": "max(0, risk - 3) * 3",
    "gates": {
      "1-3": "低风险",
      "4-5": "需人工加强审核，但可在证据充分时作为主选",
      "6-7": "较高风险，通常只做备选",
      "8-10": "高风险，默认不做"
    }
  },
  "recommendationFormula": "positiveWeightedScore - riskPenalty",
  "mainTopicHardGates": {
    "authenticityAndEvidenceMin": 8,
    "minimumPublicEvidenceItems": 1,
    "requiresConcreteChangeConflictSuccessOrFailure": true,
    "requiresAudienceTakeaway": true,
    "requiresGrowthContinuity": true,
    "requiresNextDayChallenge": true,
    "maximumRisk": 5,
    "learningDiaryOnlyIsRejected": true,
    "missingEvidenceIsRejected": true
  },
  "candidateDirections": [
    "今日进度型",
    "今日踩坑型",
    "成果展示型",
    "AI热点亲测型",
    "成长反思或真实粉丝共创型"
  ],
  "note": "候选最多5个；没有真实素材的方向必须留空，不得编造。纯热点时效性不再作为核心评分维度。"
}
