{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "koubo://schemas/technique-card/v1",
  "title": "Koubo Technique Card v1",
  "type": "object",
  "x-koubo-common-record": true,
  "required": [
    "id", "schemaVersion", "createdAt", "createdBy", "status", "source", "evidence",
    "applicability", "prohibitions", "versions", "contentHash",
    "domain", "namespace", "title", "problem", "primitive", "parameters"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "enum": [1] },
    "status": {
      "type": "string",
      "enum": ["inbox", "extracted", "recreated", "trial", "approved", "promoted", "rejected", "expired", "disabled"]
    },
    "evidence": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "domain": { "type": "string", "enum": ["caption", "motion", "sound", "voice", "visual"] },
    "namespace": { "type": "string" },
    "title": { "type": "string" },
    "problem": { "type": "string" },
    "primitive": { "type": "string" },
    "parameters": { "type": "object" }
  },
  "additionalProperties": true
}
