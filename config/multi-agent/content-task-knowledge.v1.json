    {
      "id": "content-task.experience-reuse-needs-output-comparison.v1",
      "claim": "一次失败经验只有在后续可比较任务中被实际调用，并改善真实输出和人工审核结果，才能证明它可复用。",
      "abstraction": "知识卡、复盘文档、触发规则和版本记录只证明经验被保存；是否学会必须通过调用前后输出、适用条件、无效样本和撤销机制验证。",
      "applicability": ["Agent训练", "失败经验回写", "视频返修", "字幕与动效规则", "工作流复盘"],
      "counterexamples": ["安全、隐私和合规规则可以在真实伤害发生前预防性启用。", "没有足够相似的后续任务时只能保持候选，不能为了验证强行制造发布风险。"],
      "requiredEvidence": ["失败输出及具体问题", "候选经验的适用条件和禁止条件", "后续可比较任务和调用记录", "调用前后真实输出或对照组", "人工审核结果及无效或负面样本"],
      "decisionProcedure": ["锁定要避免的具体问题而不是泛化成风格偏好", "把候选经验写成触发条件、动作、预期信号和停止条件", "在后续相似任务中显式记录是否调用", "比较调用前后输出并控制主要变量", "根据人工结果保持trial、修改、降级或撤销"],
      "failureSignals": ["只有复盘文档没有后续调用", "只记录调用次数没有输出结果", "一次成功后自动晋升", "同时改变多个变量却宣称经验有效", "只使用Agent自评或相关性指标"],
      "prohibitions": ["不得隐藏失败或无效样本", "不得用知识结构完整代替真实输出效果", "不得把相关性说成因果"],
      "evidence": [
