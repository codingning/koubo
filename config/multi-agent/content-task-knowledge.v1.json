    {
      "id": "content-task.asset-selection-needs-timeline-feedback.v1",
      "claim": "资产ID、标签、授权和哈希只能支持安全召回；Agent要学会选对素材，还必须记录语义触发点、时间线位置、候选集合及人工接受或拒绝结果。",
      "abstraction": "素材库完整不等于选择能力。应把每次素材选择编译成可比较的决策样本，区分召回错误、排序错误、时间点错误、混音错误和最终感知不合格。",
      "applicability": ["音效选择", "BGM选择", "图片与视频素材推荐", "自动剪辑", "素材库接入"],
      "counterexamples": ["纯归档或人工浏览场景只需要可检索和授权合格，不要求自动选择反馈。", "素材涉及未知或不合格授权时应直接阻断，不进入效果试验。"],
      "requiredEvidence": ["明确的叙事或动作触发点", "候选资产稳定ID和授权状态", "精确时间线位置与持续时间", "与其他音轨或画面的组合状态", "人工接受、拒绝或全组不合格结果及原因"],
      "decisionProcedure": ["先固定同一段真实时间线和表达目标", "召回多个授权合格候选并记录未入选候选", "一次只比较一个主要变量，例如素材或时间点", "让人工基于真实片段选择接受、拒绝或全组不合格", "把错误分类和结果绑定到资产、上下文和版本"],
      "failureSignals": ["只增加素材数量或标签", "只有被选素材没有候选集合", "没有精确时间点", "同时改变素材、响度和画面却归因于单项", "用Agent自评分代替真实片段审核"],
      "prohibitions": ["不得把授权合格等同于效果合格", "不得自动批准素材", "不得脱离真实片段和人工结果晋升选择规则"],
