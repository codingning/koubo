  "cards": [
    {
      "id": "content-task.tool-audit-needs-decision-thresholds.v1",
      "claim": "工具审计只有形成明确的安装、暂缓或放弃阈值，并用隔离试用结果触发该阈值，才足以支持真实决策。",
      "abstraction": "检查表和安装成功只能证明过程发生，不能证明工具值得进入当前工作流；分析必须把风险、增量价值、退出成本和环境边界转成可执行的决策条件。",
      "applicability": ["开源Skill审计", "AI工具选型", "插件安装", "本地模型试用"],
      "counterexamples": ["只做概念介绍且不提供安装建议的内容，可以不形成最终安装阈值。", "高风险权限或来源不明时可以直接停止，不需要为了比较完整而继续试用。"],
      "requiredEvidence": ["具体工具及固定版本或提交", "许可证与权限边界", "隔离试用环境和任务", "安装成功之外的真实可用指标", "安装、暂缓或放弃的实际结论与理由"],
      "decisionProcedure": ["先列出一票否决的安全、许可证和权限条件", "再定义时间、质量、稳定性或流程替代等增量指标", "在隔离环境执行同一真实任务并记录失败", "依据预先定义的阈值形成安装、暂缓或放弃结论", "保留卸载和退出路径"],
      "failureSignals": ["只展示安装界面或示例成功", "没有放弃条件", "把开源等同于安全", "没有固定版本和运行环境", "用功能数量代替真实工作流收益"],
      "prohibitions": ["不得虚构维护状态或兼容性", "不得把隔离试用成功扩大为生产可用", "不得省略高权限操作和退出成本"],
