# Optional server port. The default is 8787.
KOUBO_PORT=8787

# Optional fixed token for automation. Normal local use generates a random
# process-lifetime write token and the same-origin UI obtains it from /api/session.
KOUBO_SESSION_TOKEN=
# Comma-separated extra origins for a trusted self-hosted UI. Keep empty for
# local-only use; the server always trusts its own 127.0.0.1/localhost origin.
KOUBO_TRUSTED_ORIGINS=

# Text model used for content generation, semantic editing, and revisions.
# OPENAI_BASE_URL is optional when using the official OpenAI API.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# Controlled multi-agent runtime. The local bridge reads the same environment
# variables above; never put API keys in request/response JSON or committed files.
KOUBO_MULTI_AGENT_ENABLED=0
# The two content advisory roles are enabled by default without enabling the
# experimental Caption/Motion/Sound proposal pipeline.
KOUBO_CONTENT_ADVISORY_ENABLED=1
# Agents SDK prompt/output tracing is privacy-sensitive and opt-in only.
KOUBO_AGENT_TRACING_ENABLED=0
KOUBO_MULTI_AGENT_PYTHON=.runtime-multi-agent/Scripts/python.exe
KOUBO_MULTI_AGENT_DATA_ROOT=data/multi-agent

# Optional OpenCLI profile used for read-only Douyin reference research.
# If omitted, the workbench prefers the connected profile marked as default.
OPENCLI_PROFILE=

# Research related Douyin videos before every script generation.
KOUBO_LIVE_REFERENCE_RESEARCH=1

# Optional faster-whisper download settings.
# HF_ENDPOINT=https://hf-mirror.com
HF_HUB_DISABLE_XET=1
